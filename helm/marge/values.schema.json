{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity for the pod",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Overrides the fully qualified resource name"
        },
        "gcpProject": {
            "type": "string"
        },
        "global": {
            "type": [
                "object",
                "null"
            ],
            "description": "Global values shared between all subcharts",
            "$comment": "Added automatically by 'helm schema' to allow this chart to be used as a Helm dependency, as this schema would otherwise not allow Helm's special 'global' values key."
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy"
                },
                "registry": {
                    "type": "string",
                    "description": "Registry of the marge image"
                },
                "repository": {
                    "type": "string",
                    "description": "Repository of the marge image"
                },
                "tag": {
                    "type": "string",
                    "description": "Overrides the image tag whose default is the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets for the pod"
        },
        "marge": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "circleci": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing Secret holding the CircleCI token. Takes precedence over token."
                        },
                        "existingSecretKey": {
                            "type": "string",
                            "description": "Key of the CircleCI token inside existingSecret"
                        },
                        "token": {
                            "type": "string",
                            "description": "CircleCI API token, optional: lets marge inspect private CircleCI projects and retry auto-cancelled builds. The chart writes it into a Secret; prefer existingSecret in production."
                        }
                    }
                },
                "github": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "app": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "existingSecret": {
                                    "type": "string",
                                    "description": "Name of an existing Secret holding the App credential. Takes precedence over the inline values, and must carry every key named below."
                                },
                                "id": {
                                    "type": "string",
                                    "description": "Numeric ID of the sweep GitHub App. Required by the scheduled sweeps, which mint an installation token per repository instead of holding a token."
                                },
                                "idKey": {
                                    "type": "string",
                                    "description": "Key of the App ID inside the Secret"
                                },
                                "installationId": {
                                    "type": "string",
                                    "description": "Numeric ID of the App's installation on the organization."
                                },
                                "installationIdKey": {
                                    "type": "string",
                                    "description": "Key of the installation ID inside the Secret"
                                },
                                "privateKey": {
                                    "type": "string",
                                    "description": "PEM private key of the App. The chart writes it into a Secret; prefer existingSecret in production. The values of this item live in 1Password, in the Team Bumblebee vault, item \"marge sweep GitHub App\"."
                                },
                                "privateKeyKey": {
                                    "type": "string",
                                    "description": "Key of the PEM private key inside the Secret"
                                }
                            }
                        },
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing Secret holding the GitHub token. Takes precedence over token."
                        },
                        "existingSecretKey": {
                            "type": "string",
                            "description": "Key of the GitHub token inside existingSecret"
                        },
                        "token": {
                            "type": "string",
                            "description": "GitHub token marge uses (needs the permissions listed in the repository README). The chart writes it into a Secret; prefer existingSecret in production. The scheduled sweeps ignore it and act as the App instead."
                        }
                    }
                },
                "slack": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "existingSecret": {
                            "type": "string",
                            "description": "Name of an existing Secret holding the Slack bot token. Takes precedence over token."
                        },
                        "existingSecretKey": {
                            "type": "string",
                            "description": "Key of the Slack bot token inside existingSecret"
                        },
                        "token": {
                            "type": "string",
                            "description": "Bot token of the sweep's own Slack app, which holds chat:write and nothing else. Without it a scheduled sweep does its work and posts no summary."
                        }
                    }
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Run the MCP server: the Deployment, its Service and its NetworkPolicy. Turn it off on an installation that runs the scheduled sweep alone. Registering the server with a muster is the platform's job: an MCPServer that points at the Service URL, with the muster's own GitHub client."
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Overrides the chart name in resource names"
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Create a NetworkPolicy: ingress to the MCP port from the selected namespaces, egress to DNS and HTTPS only (GitHub, CircleCI)."
                },
                "ingressNamespaceSelector": {
                    "type": "object",
                    "description": "Namespaces allowed to reach the MCP port; an empty selector allows every namespace of the cluster.",
                    "additionalProperties": true
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector for the pod",
            "additionalProperties": true
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations to add to the pod",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels to add to the pod",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod-level security context (restricted Pod Security Standard)",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of marge replicas. The MCP transport is stateful per session, so keep it at 1 unless a client-affine load balancer sits in front."
        },
        "resources": {
            "type": "object",
            "description": "Container resources. The pod mounts an emptyDir on /tmp, so ephemeral-storage is bounded as well: a container that mounts one without both bounds is refused by the restricted policies.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "scheduleDefaults": {
            "type": "object",
            "description": "Values every entry of schedules takes for the keys it does not set itself.",
            "additionalProperties": false,
            "properties": {
                "actions": {
                    "type": "string",
                    "description": "Sweep steps a scheduled sweep performs. Every step here acts through the GitHub or CircleCI API; none of them writes code to a branch."
                },
                "activeDeadlineSeconds": {
                    "type": "integer",
                    "description": "Seconds a scheduled run may take before Kubernetes stops it."
                },
                "dryRun": {
                    "type": "boolean",
                    "description": "Report every outcome without writing anything. Turn it on for the first runs on a new installation."
                },
                "failedJobsHistoryLimit": {
                    "type": "integer",
                    "description": "Failed Jobs kept"
                },
                "resources": {
                    "type": "object",
                    "description": "Container resources of a scheduled run. The pod mounts an emptyDir on /tmp, so ephemeral-storage is bounded as well: a container that mounts one without both bounds is refused by the restricted policies.",
                    "additionalProperties": false,
                    "properties": {
                        "limits": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "integer"
                                },
                                "ephemeral-storage": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        },
                        "requests": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "ephemeral-storage": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "successfulJobsHistoryLimit": {
                    "type": "integer",
                    "description": "Successful Jobs kept"
                },
                "timeZone": {
                    "type": "string",
                    "description": "IANA timezone the cron expressions are read in."
                }
            }
        },
        "schedules": {
            "type": "array",
            "description": "Scheduled runs, one CronJob each. An entry sweeps one team, so every team carries its own cadence and its own suspension. Needs marge.github.app. Stagger the expressions: every run acts as the same GitHub App and shares its rate limit."
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context (restricted Pod Security Standard)",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type"
                },
                "port": {
                    "type": "integer",
                    "description": "Service port; the container listens on 8080"
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations to add to the ServiceAccount",
                    "additionalProperties": true
                },
                "automount": {
                    "type": "boolean",
                    "description": "Mount the ServiceAccount token into the pod"
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount for the pod. marge talks to GitHub and CircleCI only, so it needs no Kubernetes API access."
                },
                "name": {
                    "type": "string",
                    "description": "Name of the ServiceAccount to use. Generated from the fullname when empty and create is true."
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "suspendAll": {
            "type": "boolean",
            "description": "Suspend every scheduled run without deleting its entry. A single run is suspended on its own entry instead."
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations for the pod"
        }
    }
}
